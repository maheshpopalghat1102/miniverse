NODE_ENV=development
PORT=5001
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/miniverse
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters

# Optional: configure all four values to enable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional: configure all three values to enable image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
